<Project>
  <PropertyGroup>
    <ImportDirectoryBuildProps>false</ImportDirectoryBuildProps>
    <ImportDirectoryBuildTargets>false</ImportDirectoryBuildTargets>
  </PropertyGroup>
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <DefineConstants>R2023</DefineConstants>
    <Nullable>disable</Nullable>
    <AssemblyName>SlabReinforcement.RevitSmoke</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <UseWPF>true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="RevitAPI"><HintPath>C:\Program Files\Autodesk\Revit 2023\RevitAPI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="RevitAPIUI"><HintPath>C:\Program Files\Autodesk\Revit 2023\RevitAPIUI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.Web.Extensions" />
    <Compile Include="SmokeApplication.cs" />
    <Compile Include="ProductRuntimeProbe.cs" />
    <Compile Include="ExistingStirrupProbe.cs" />
    <Compile Include="..\SlabReinforcement\Integration\*.cs" Link="Integration\%(Filename)%(Extension)" />
    <Compile Include="..\SlabReinforcement\Preview\PreviewContracts.cs" Link="PreviewContracts.cs" />
    <ProjectReference Include="..\SlabReinforcement.Core\SlabReinforcement.Core.csproj" />
    <ProjectReference Include="..\SlabReinforcement.Dxf\SlabReinforcement.Dxf.csproj" />
  </ItemGroup>
  <Import Project="Sdk.targets" Sdk="Microsoft.NET.Sdk" />
</Project>
