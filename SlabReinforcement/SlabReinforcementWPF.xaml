<Window x:Class="SlabReinforcement.SlabReinforcementWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SlabReinforcement"
        Title="Армирование плит" Width="1280" Height="850" MinWidth="1024" MinHeight="640"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Icon="Resources/citrus.ico"
        Background="{DynamicResource Neutral100Brush}" FontFamily="{DynamicResource BaseFont}"
        FontSize="13" Foreground="{DynamicResource TextBrush}" Loaded="Window_Loaded" Closed="Window_Closed">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="CitrusTheme/CitrusTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
                <Setter Property="MaxWidth" Value="400" />
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" /></DataTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="SectionLabel" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Margin" Value="0,0,0,12" />
            </Style>
            <Style x:Key="FormLabel" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,0,6" />
                <Setter Property="FontSize" Value="12" />
            </Style>
            <Style x:Key="FormNumber" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinHeight" Value="32" />
            </Style>
            <Style x:Key="CompactExpander" TargetType="Expander">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Expander">
                            <StackPanel>
                                <ToggleButton Content="{TemplateBinding Header}" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="HeaderBorder" Background="Transparent" CornerRadius="4" Padding="6,5" BorderBrush="Transparent" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <Path x:Name="Chevron" Data="M 0 0 L 4 4 L 0 8" Stroke="{StaticResource SubtleTextBrush}" StrokeThickness="1.5" Width="5" Height="9" Stretch="None" VerticalAlignment="Center" HorizontalAlignment="Left" />
                                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chevron" Property="Data" Value="M 0 1 L 4 5 L 8 1" /><Setter TargetName="Chevron" Property="Width" Value="9" /></Trigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="Background" Value="{StaticResource Neutral100Brush}" /></Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="6,4,6,2" />
                            </StackPanel>
                            <ControlTemplate.Triggers><Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" /></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ComponentTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TabItem">
                            <Border x:Name="TabBorder" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="10,7">
                                <ContentPresenter x:Name="TabHeader" ContentSource="Header" TextElement.FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" /><Setter TargetName="TabHeader" Property="TextElement.FontWeight" Value="SemiBold" /></Trigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{StaticResource Neutral100Brush}" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1" Padding="20,10">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Армирование плит" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock x:Name="HostDescription" Grid.Column="1" Foreground="{StaticResource SubtleTextBrush}" Margin="18,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="18,12,18,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440" MinWidth="410" MaxWidth="580" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" MinWidth="390" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="8">
                <TabControl x:Name="ComponentsTabs" Margin="6" BorderThickness="0" SelectionChanged="ComponentsTabs_SelectionChanged">
                    <TabItem x:Name="BackgroundTab" Header="Фон и обрамление" Style="{StaticResource ComponentTab}">
                        <ScrollViewer x:Name="BackgroundScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="6,10,6,4">
                            <StackPanel>
                                <TextBlock Text="Фон" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                                <DataGrid x:Name="BackgroundDataGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="✓" Width="28"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Включить слой фона" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Слой" Binding="{Binding Direction}" IsReadOnly="True" Width="64">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="{x:Type TextBlock}" BasedOn="{x:Static DataGridTextColumn.DefaultElementStyle}">
                                                    <Setter Property="VerticalAlignment" Value="Center" />
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTemplateColumn Header="Тип арматуры" Width="*" MinWidth="120"><DataGridTemplateColumn.CellTemplate><DataTemplate><ComboBox ItemsSource="{Binding RebarTypes}" SelectedItem="{Binding SelectedRebarType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="Name" Margin="2" MinHeight="31" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Макс. шаг, мм" Width="94"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding SpacingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormNumber}" Margin="2" ToolTip="Максимальное расстояние между стержнями. Крайние ряды — по защитному слою." /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <CheckBox x:Name="CheckBox_PerimeterEnabled" Content="Создать П-обрамление" FontWeight="SemiBold" Margin="0,18,0,10" Checked="Parameter_Checked" Unchecked="Parameter_Checked" />
                                <StackPanel>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <CheckBox x:Name="CheckBox_PerimeterOuter" Content="Наружный контур" Checked="Parameter_Checked" Unchecked="Parameter_Checked" />
                                        <CheckBox x:Name="CheckBox_PerimeterOpenings" Grid.Column="1" Content="Отверстия" Checked="Parameter_Checked" Unchecked="Parameter_Checked" />
                                    </Grid>
                                    <TextBlock Text="Тип арматуры" Style="{StaticResource FormLabel}" />
                                    <ComboBox x:Name="ComboBox_PerimeterType" DisplayMemberPath="Name" MinHeight="32" Margin="0,0,0,10" SelectionChanged="Parameter_SelectionChanged" />
                                    <TextBlock x:Name="TextBlock_PerimeterLengthPolicy" Text="Длина П — автоматически, для 100% растянутых стыков в одном сечении." ToolTip="По бетону, классу и диаметру арматуры." TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,12" />
                                    <TextBlock Text="Шаг П, мм" Style="{StaticResource FormLabel}" />
                                    <TextBox x:Name="TextBox_PerimeterSpacing" Style="{StaticResource FormNumber}" TextChanged="Parameter_TextChanged"
                                             ToolTip="П — по рядам нижнего фона. Без фона — с указанным шагом." />
                                    <TextBlock x:Name="TextBlock_PerimeterDistribution" Text="Шаг задан вручную" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="ZonesTab" Header="Зоны" Style="{StaticResource ComponentTab}">
                <ScrollViewer x:Name="ZonesScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="6,8,12,4">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="Button_SelectUnderlay" Content="Выбрать подложку" Style="{StaticResource ButtonOutline}"
                                    Click="Button_SelectUnderlay_Click" ToolTip="Выбрать DWG/DXF в модели Revit" />
                            <TextBlock x:Name="UnderlayName" Grid.Column="1" Text="Не выбрана" Margin="10,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="{StaticResource SubtleTextBrush}"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </Grid>
                        <StackPanel x:Name="SourceGroupPanel" Margin="0,0,0,8" Visibility="Collapsed">
                            <Grid>
                            <ComboBox x:Name="ComboBox_SourceGroup" MinHeight="34" DisplayMemberPath="DisplayName" SelectedValuePath="Group.Key"
                                      SelectionChanged="SourceGroup_SelectionChanged"
                                      ToolTip="Используются зоны выбранного слоя на указанной высоте." />
                            <TextBlock x:Name="SourceGroupPlaceholder" Text="Выберите слой и высоту" Margin="12,0,32,0"
                                       VerticalAlignment="Center" Foreground="{StaticResource SubtleTextBrush}"
                                       IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedIndex, ElementName=ComboBox_SourceGroup}" Value="-1">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            </Grid>
                        </StackPanel>
                        <ComboBox x:Name="ComboBox_DemandMeaning" DisplayMemberPath="DisplayName" SelectedValuePath="Key" MinHeight="30" Margin="0,0,0,8" SelectionChanged="DemandMeaning_SelectionChanged" ToolTip="Ручное назначение — без проверки площади. Дополнительная площадь — только зоны. Полная — с учётом проверенного существующего фона." />
                    </StackPanel>
                    <DataGrid x:Name="ColorStatsDataGrid" Height="260" AutoGenerateColumns="False" CanUserAddRows="False"
                              CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" CanUserResizeColumns="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              HeadersVisibility="Column" RowHeaderWidth="0" SelectionMode="Single" SelectionUnit="FullRow"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True" MinHeight="104">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="✓" Width="28">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="Создать зоны этого цвета" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Цвет" Width="40">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><Border Background="{Binding ColorBrush}" BorderBrush="{StaticResource Neutral350Brush}" BorderThickness="1" CornerRadius="3" Width="27" Height="23" Margin="4" ToolTip="{Binding Color}" /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Тип арматуры" Width="*" MinWidth="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox ItemsSource="{Binding RebarTypes}" SelectedItem="{Binding SelectedRebarType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  DisplayMemberPath="Name" Margin="2" MinHeight="31" ToolTip="Вдоль одной линии — наибольший диаметр и его шаг. При равных диаметрах — меньший шаг." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Шаг, мм" Width="72">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBox Text="{Binding SpacingText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormNumber}" Margin="2" ToolTip="Вдоль одной линии — шаг наибольшего диаметра. При равных диаметрах — меньший шаг." /></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn x:Name="RequiredAreaColumn" Header="мм²/м" Width="86" Visibility="Collapsed">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding RequiredAreaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FormNumber}" Margin="2" ToolTip="Максимальная площадь для цвета, мм²/м. См²/м умножьте на 100. Для «больше…» уточните максимум в расчёте." /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Expander x:Name="ZoneSettingsExpander" Header="Параметры зон" IsExpanded="True" Margin="0,12,0,4" Style="{StaticResource CompactExpander}">
                        <StackPanel x:Name="ZoneSettingsPanel" Margin="0,4,0,4">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Направление" Style="{StaticResource FormLabel}" /><ComboBox x:Name="ComboBox_Direction" MinHeight="32" SelectionChanged="Parameter_SelectionChanged" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Объединение, мм" Style="{StaticResource FormLabel}" ToolTip="Допуск для выравнивания концов соседних рядов и объединения близких участков с одинаковой арматурой." /><TextBox x:Name="TextBox_ZoneMergeTolerance" Style="{StaticResource FormNumber}" TextChanged="Parameter_TextChanged" /></StackPanel>
                            </Grid>
                            <TextBlock Text="Округление длины" Style="{StaticResource FormLabel}" Margin="0,12,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="66" /></Grid.ColumnDefinitions>
                                    <RadioButton x:Name="RadioButton_RoundIncrement" Content="Кратно, мм" GroupName="Rounding" VerticalAlignment="Center" Checked="Parameter_Checked" />
                                    <TextBox x:Name="TextBox_RoundIncrement" Grid.Column="1" Style="{StaticResource FormNumber}" IsEnabled="{Binding IsChecked, ElementName=RadioButton_RoundIncrement}" TextChanged="Parameter_TextChanged" />
                                </Grid>
                                <RadioButton x:Name="RadioButton_RoundCutLengths" Grid.Column="2" Content="Стандартная нарезка" GroupName="Rounding" VerticalAlignment="Center" Checked="Parameter_Checked" />
                            </Grid>
                            <CheckBox x:Name="CheckBox_ZoneEndsInPerimeter" Margin="0,16,0,10" Checked="Parameter_Checked" Unchecked="Parameter_Checked"
                                      ToolTipService.ShowOnDisabled="True" ToolTip="Только при ручном назначении. П — у концов зон без места для прямой анкеровки.">
                                <TextBlock Text="При нехватке анкеровки — П-окончания" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock Text="Тип и шаг — по зоне" Foreground="{StaticResource SubtleTextBrush}" Margin="0,0,0,6" />
                            <TextBlock x:Name="TextBlock_ZoneLengthPolicy" Text="Длина П — автоматически, для 100% растянутых стыков в одном сечении." ToolTip="По бетону, классу и диаметру арматуры зоны." TextWrapping="Wrap" Foreground="{StaticResource SubtleTextBrush}" />
                        </StackPanel>
                    </Expander>
                </StackPanel></ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Border Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid Margin="14,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Предпросмотр" FontSize="16" FontWeight="SemiBold" ToolTip="{Binding Text, ElementName=AxisDescription}" />
                                <TextBlock x:Name="AxisDescription" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="−" Width="31" Margin="0,0,5,0" Style="{StaticResource ButtonOutline}" Click="ZoomOut_Click" ToolTip="Уменьшить" />
                                <Button Content="+" Width="31" Margin="0,0,5,0" Style="{StaticResource ButtonOutline}" Click="ZoomIn_Click" ToolTip="Увеличить" />
                                <Button Content="Вписать" Style="{StaticResource ButtonOutline}" Click="Fit_Click" />
                            </StackPanel>
                        </Grid>
                        <local:SlabPreviewCanvas x:Name="PreviewCanvas" Grid.Row="1" MinHeight="100" ClipToBounds="True" Focusable="True" />
                        <Border Grid.Row="2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="14,6">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="PreviewNavigationHint" Grid.ColumnSpan="3" FontSize="11" Foreground="{StaticResource SubtleTextBrush}" TextWrapping="Wrap"
                                           Text="Колесо — масштаб · Перетаскивание — сдвиг · Двойной щелчок — показать целиком" />
                                <TextBlock x:Name="PreviewLegendBackground" Grid.Row="1" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap">
                                    <Run Text="Фон" Foreground="#3482A4" /><Run Text=" · " /><Run Text="П-обрамление" Foreground="#DB6430" />
                                </TextBlock>
                                <TextBlock x:Name="PreviewLegendZones" Grid.Row="1" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Visibility="Collapsed">
                                    <Run Text="Зоны" Foreground="{StaticResource SubtleTextBrush}" /><Run Text=" · " /><Run Text="П-окончания" Foreground="#DB6430" />
                                </TextBlock>
                                <TextBlock x:Name="PlanSummary" Grid.Row="1" Grid.Column="2" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" HorizontalAlignment="Right" Margin="0,4,0,0" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,10,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel>
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource WarningBrush}" Margin="0,0,8,0" />
                            <TextBlock x:Name="StatusText" Text="Подготовка предпросмотра" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </DockPanel>
                        <ProgressBar x:Name="CalculationProgress" Grid.Row="1" Height="3" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed" />
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="64" Margin="0,6,0,0">
                            <ItemsControl x:Name="DiagnosticsList">
                                <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,5" Foreground="{StaticResource SubtleTextBrush}" /></DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                        <Expander x:Name="ContextWarningsExpander" Grid.Row="3" IsExpanded="False" Margin="0,4,0,0" Visibility="Collapsed" Style="{StaticResource CompactExpander}">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="72">
                                <ItemsControl x:Name="ContextWarningsList">
                                    <ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,5" Foreground="{StaticResource SubtleTextBrush}" /></DataTemplate></ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Margin="18,0,18,10" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="8,6">
            <Expander x:Name="SettingsExpander" IsExpanded="False" Style="{StaticResource CompactExpander}">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Плита и защитный слой" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedItem, ElementName=ComboBox_ConcreteClass}" Margin="12,0,0,0" FontWeight="Normal" Foreground="{StaticResource SubtleTextBrush}" />
                    </StackPanel>
                </Expander.Header>
                <ScrollViewer x:Name="SettingsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="110">
                    <StackPanel Margin="2,4,12,4">
                        <StackPanel x:Name="CommonSettingsPanel">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104" /><ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="104" /><ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="104" /><ColumnDefinition Width="12" /><ColumnDefinition Width="104" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="Бетон" Style="{StaticResource FormLabel}" /><ComboBox x:Name="ComboBox_ConcreteClass" MinHeight="32" SelectionChanged="Parameter_SelectionChanged" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Сверху, мм" Style="{StaticResource FormLabel}" /><TextBox x:Name="TextBox_TopCover" Style="{StaticResource FormNumber}" TextChanged="Parameter_TextChanged" /></StackPanel>
                                <StackPanel Grid.Column="4"><TextBlock Text="Снизу, мм" Style="{StaticResource FormLabel}" /><TextBox x:Name="TextBox_BottomCover" Style="{StaticResource FormNumber}" TextChanged="Parameter_TextChanged" /></StackPanel>
                                <StackPanel Grid.Column="6"><TextBlock Text="На торце, мм" Style="{StaticResource FormLabel}" /><TextBox x:Name="TextBox_EdgeCover" Style="{StaticResource FormNumber}" TextChanged="Parameter_TextChanged" /></StackPanel>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Expander>
        </Border>
        <Border Grid.Row="3" Background="{StaticResource CardBgBrush}" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="Отмена" Width="100" Margin="0,0,10,0" Style="{StaticResource ButtonOutline}" IsCancel="True" Click="Button_Cancel_Click" />
                    <Button x:Name="Button_Confirm" Content="Создать армирование" MinWidth="190" MinHeight="36" IsEnabled="False" Click="Button_Ok_Click" />
                </StackPanel>
